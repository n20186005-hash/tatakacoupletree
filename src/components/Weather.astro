---
// 伺服器端（Server Component）在天氣資料請求時於伺服器取得並快取，
// 一般訪客只需看「現在幾度、要不要帶傘、這樣的天適合怎麼玩」，不需了解資料來源細節。
import { getTranslations, getAdvice, type AdviceKey } from '../i18n/ui';

interface Props {
  locale?: string;
}
const { locale = 'zh-Hant' } = Astro.props;
const tw = getTranslations(locale).weather;
const A = getAdvice(locale);

const LAT = 23.5125202;
const LON = 120.8907209;

const wmo: Record<number, { label: string; icon: string }> = {
  0: { label: '晴朗', icon: '☀️' },
  1: { label: '多雲時晴', icon: '🌤️' },
  2: { label: '局部多雲', icon: '⛅' },
  3: { label: '陰天', icon: '☁️' },
  45: { label: '有霧', icon: '🌫️' },
  48: { label: '霧凇', icon: '🌫️' },
  51: { label: '細毛毛雨', icon: '🌦️' },
  53: { label: '毛毛雨', icon: '🌧️' },
  55: { label: '強毛毛雨', icon: '🌧️' },
  56: { label: '凍毛毛雨', icon: '🌧️' },
  57: { label: '強凍毛毛雨', icon: '🌧️' },
  61: { label: '小雨', icon: '🌧️' },
  63: { label: '中雨', icon: '🌧️' },
  65: { label: '大雨', icon: '🌧️' },
  66: { label: '凍雨', icon: '🌧️' },
  67: { label: '強凍雨', icon: '🌧️' },
  71: { label: '小雪', icon: '🌨️' },
  73: { label: '中雪', icon: '🌨️' },
  75: { label: '大雪', icon: '❄️' },
  77: { label: '雪粒', icon: '🌨️' },
  80: { label: '陣雨', icon: '🌦️' },
  81: { label: '強陣雨', icon: '🌧️' },
  82: { label: '強陣雨天氣', icon: '⛈️' },
  85: { label: '陣雪', icon: '🌨️' },
  86: { label: '強陣雪', icon: '❄️' },
  95: { label: '雷雨', icon: '⛈️' },
  96: { label: '雷雨伴冰雹', icon: '⛈️' },
  99: { label: '強雷雨冰雹', icon: '⛈️' },
};

function describe(code: number) {
  return wmo[code] ?? { label: '多雲', icon: '🌥️' };
}

function fmtDay(iso: string) {
  const d = new Date(iso + 'T12:00:00+08:00');
  return new Intl.DateTimeFormat(locale.toLowerCase().startsWith('en') ? 'en-US' : 'zh-TW', {
    month: 'numeric',
    day: 'numeric',
    weekday: 'short',
  }).format(d);
}

function beaufort(ms: number): number {
  const steps = [0.3, 1.6, 3.4, 5.5, 8.0, 10.8, 13.9, 17.2, 20.8, 24.5, 28.5, 32.7];
  let b = 0;
  for (let i = 0; i < steps.length; i++) if (ms >= steps[i]) b = i + 1;
  return b;
}

interface DailyItem {
  day: string;
  icon: string;
  label: string;
  max: number;
  min: number;
  pop: number | null;
  uv: number | null;
}

interface Advice {
  outfit: AdviceKey[];
  activity: AdviceKey[];
  items: AdviceKey[];
  risk: AdviceKey[];
}

// 依據天氣資料直接產生「遊客看得懂、能執行」的建議（以短語鍵表示，再依語系轉文字）；
// 不滿足條件就不顯示。
function buildAdvice(p: {
  code: number;
  maxT: number;
  minT: number;
  pop: number;
  uv: number;
  windMs: number;
}): Advice {
  const outfit: AdviceKey[] = [];
  const activity: AdviceKey[] = [];
  const items: AdviceKey[] = [];
  const risk: AdviceKey[] = [];

  const isThunder = [95, 96, 99].includes(p.code);
  const isSnow = [71, 73, 75, 77, 85,86].includes(p.code);
  const isFog = [45, 48].includes(p.code);
  const isRain = [51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82].includes(p.code);
  const heavyRain = [65, 66, 67, 81, 82].includes(p.code);
  const modRain = [63, 80].includes(p.code);
  const windB = beaufort(p.windMs);

  if (isThunder) {
    risk.push('riskThunder');
    activity.push('actThunder');
    items.push('itemRaincoatThunder');
  } else if (isRain) {
    if (heavyRain) {
      risk.push('riskHeavyRain');
      activity.push('actHeavyRain');
      items.push('itemRainHeavy');
    } else if (modRain) {
      activity.push('actModRain');
      items.push('itemRainMod');
    } else {
      activity.push('actLightRain');
      items.push('itemRainLight');
    }
    outfit.push('outfitWaterproof');
  } else if (isSnow) {
    risk.push('riskSnow');
    outfit.push('outfitCold');
    activity.push('actFog');
  } else if (isFog) {
    risk.push('riskFog');
    activity.push('actFog');
  } else if (p.code === 0) {
    activity.push('actClear');
    items.push('itemUv');
  } else if (p.code === 1 || p.code === 2) {
    activity.push('actPartly');
  } else if (p.code === 3) {
    activity.push('actCloudy');
  }

  if (p.pop >= 60 && !isRain && !isThunder) {
    activity.push('actPop');
    items.push('itemPop');
  }

  if (p.uv >= 5) {
    items.push('itemUv');
    activity.push('actUv');
  }

  if (p.maxT - p.minT > 8) outfit.push('outfitLayered');
  if (p.minT <= 10) outfit.push('outfitColdNight');
  if (p.maxT <= 10) {
    outfit.push('outfitCold');
    items.push('itemCold');
  }
  if (p.maxT >= 32) {
    outfit.push('outfitHot');
    items.push('itemWater');
  }

  if (windB >= 7) {
    risk.push('riskWind');
    outfit.push('outfitWind');
  } else if (windB >= 5) {
    activity.push('actWind');
    outfit.push('outfitWindCarry');
  }

  return {
    outfit: [...new Set(outfit)],
    activity: [...new Set(activity)],
    items: [...new Set(items)],
    risk: [...new Set(risk)],
  };
}

let cache: { ts: number; value: unknown } | null = null;
const TTL = 30 * 60 * 1000;

async function loadWeather() {
  const now = Date.now();
  if (cache && now - cache.ts < TTL) return cache.value;

  try {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 6000);
    const url =
      `https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}` +
      `&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,precipitation` +
      `&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max` +
      `&timezone=Asia%2FTaipei&forecast_days=7&wind_speed_unit=ms`;
    const res = await fetch(url, { signal: ctrl.signal });
    clearTimeout(timer);
    if (!res.ok) throw new Error('weather http ' + res.status);
    const data = await res.json();
    const cur = data.current;
    const daily = (data.daily?.time ?? []).slice(0, 7).map((iso: string, i: number) => {
      const d = describe(data.daily.weather_code[i]);
      return {
        day: fmtDay(iso),
        icon: d.icon,
        label: d.label,
        max: Math.round(data.daily.temperature_2m_max[i]),
        min: Math.round(data.daily.temperature_2m_min[i]),
        pop: data.daily.precipitation_probability_max?.[i] ?? null,
        uv: data.daily.uv_index_max?.[i] ?? null,
      } as DailyItem;
    });
    const today = daily[0];
    const value = {
      current: {
        temp: Math.round(cur.temperature_2m),
        feels: Math.round(cur.apparent_temperature),
        humidity: cur.relative_humidity_2m,
        wind: Math.round(cur.wind_speed_10m),
        code: cur.weather_code,
        rain: cur.precipitation,
      },
      daily,
      advice: buildAdvice({
        code: cur.weather_code,
        maxT: today?.max ?? Math.round(cur.temperature_2m),
        minT: today?.min ?? Math.round(cur.temperature_2m),
        pop: today?.pop ?? 0,
        uv: today?.uv ?? 0,
        windMs: cur.wind_speed_10m,
      }),
    };
    cache = { ts: now, value };
    return value;
  } catch {
    return null;
  }
}

const weather = (await loadWeather()) as {
  current: { temp: number; feels: number; humidity: number; wind: number; code: number; rain: number };
  daily: DailyItem[];
  advice: Advice;
} | null;
const currentDesc = weather ? describe(weather.current.code) : null;
const windB = weather ? beaufort(weather.current.wind) : 0;
---

<section id="weather" class="bg-[#173c32] py-20 text-white lg:py-28">
  <div class="container-shell">
    <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
      <div>
        <span class="eyebrow !text-[#d7a85b]">{tw.eyebrow}</span>
        <h2 class="section-title">{tw.title}</h2>
      </div>
      <p class="prose-copy max-w-2xl leading-8 text-white/60 lg:justify-self-end">
        {tw.intro}
      </p>
    </div>

    {
      weather && currentDesc ? (
        <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_1.4fr]">
          <div class="rounded-[1.6rem] border border-white/12 bg-white/6 p-8">
            <p class="text-sm font-bold tracking-[0.16em] text-[#d7a85b]">{tw.currentLabel}</p>
            <div class="mt-4 flex items-center gap-5">
              <span class="text-6xl leading-none">{currentDesc.icon}</span>
              <div>
                <p class="font-serif text-6xl leading-none">{weather.current.temp}<span class="text-3xl">°C</span></p>
                <p class="mt-2 text-white/75">{currentDesc.label}</p>
              </div>
            </div>
            <dl class="mt-7 grid grid-cols-2 gap-4 text-sm">
              <div class="rounded-xl bg-black/15 p-4">
                <dt class="text-white/55">{tw.feelsLabel}</dt>
                <dd class="mt-1 font-serif text-2xl">{weather.current.feels}°C</dd>
              </div>
              <div class="rounded-xl bg-black/15 p-4">
                <dt class="text-white/55">{tw.humidityLabel}</dt>
                <dd class="mt-1 font-serif text-2xl">{weather.current.humidity}%</dd>
              </div>
              <div class="rounded-xl bg-black/15 p-4">
                <dt class="text-white/55">{tw.windLabel}</dt>
                <dd class="mt-1 font-serif text-2xl">{windB}<span class="text-base"> / {weather.current.wind} m/s</span></dd>
              </div>
              <div class="rounded-xl bg-black/15 p-4">
                <dt class="text-white/55">{tw.popLabel}</dt>
                <dd class="mt-1 font-serif text-2xl">{weather.daily[0]?.pop ?? '—'}<span class="text-base"> %</span></dd>
              </div>
            </dl>
          </div>

          <div class="rounded-[1.6rem] border border-white/12 bg-white/6 p-8">
            <p class="text-sm font-bold tracking-[0.16em] text-[#d7a85b]">{tw.forecastLabel}</p>
            <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
              {weather.daily.map((d) => (
                <div class="rounded-2xl bg-black/15 p-4 text-center">
                  <p class="text-xs text-white/55">{d.day}</p>
                  <p class="my-2 text-3xl">{d.icon}</p>
                  <p class="text-sm text-white/80">{d.label}</p>
                  <p class="mt-2 font-serif text-lg">{d.max}°<span class="text-white/50"> / {d.min}°</span></p>
                  {d.pop !== null && <p class="mt-1 text-xs text-[#9ec7b8]">{d.pop}%</p>}
                </div>
              ))}
            </div>
            <p class="mt-5 text-xs text-white/40">{tw.sourceNote}</p>
          </div>
        </div>
      ) : (
        <div class="mt-10 rounded-[1.6rem] border border-white/12 bg-white/6 p-8 text-white/70">
          {tw.fallback}
        </div>
      )
    }

    {
      weather && weather.advice && (
        <div class="mt-6 grid gap-5 lg:grid-cols-[1.3fr_.7fr]">
          <div class="grid gap-5 sm:grid-cols-3">
            {weather.advice.outfit.length > 0 && (
              <div class="rounded-2xl border border-white/12 bg-white/6 p-6">
                <p class="text-xs font-bold tracking-[0.14em] text-[#d7a85b]">{tw.outfitTitle}</p>
                <ul class="mt-3 space-y-2 text-sm leading-7 text-white/85">
                  {weather.advice.outfit.map((k) => <li>{A[k]}</li>)}
                </ul>
              </div>
            )}
            {weather.advice.activity.length > 0 && (
              <div class="rounded-2xl border border-white/12 bg-white/6 p-6">
                <p class="text-xs font-bold tracking-[0.14em] text-[#d7a85b]">{tw.activityTitle}</p>
                <ul class="mt-3 space-y-2 text-sm leading-7 text-white/85">
                  {weather.advice.activity.map((k) => <li>{A[k]}</li>)}
                </ul>
              </div>
            )}
            {weather.advice.items.length > 0 && (
              <div class="rounded-2xl border border-white/12 bg-white/6 p-6">
                <p class="text-xs font-bold tracking-[0.14em] text-[#d7a85b]">{tw.itemsTitle}</p>
                <ul class="mt-3 space-y-2 text-sm leading-7 text-white/85">
                  {weather.advice.items.map((k) => <li>{A[k]}</li>)}
                </ul>
              </div>
            )}
          </div>

          <div class="flex items-center">
            {weather.advice.risk.length > 0 ? (
              <div class="w-full rounded-2xl border border-[#e8a0a0]/40 bg-[#e8a0a0]/12 p-6">
                <p class="text-sm font-bold tracking-[0.14em] text-[#f3c0c0]">{tw.riskTitle}</p>
                <ul class="mt-3 space-y-2 text-sm leading-7 text-white/90">
                  {weather.advice.risk.map((k) => <li>{A[k]}</li>)}
                </ul>
              </div>
            ) : (
              <div class="w-full rounded-2xl border border-[#9ec7b8]/30 bg-[#9ec7b8]/10 p-6">
                <p class="text-sm font-bold tracking-[0.14em] text-[#bfe0d2]">{tw.riskNoneTitle}</p>
                <p class="mt-3 text-sm leading-7 text-white/80">{tw.riskNoneBody}</p>
              </div>
            )}
          </div>
        </div>
      )
    }

    <p class="mt-6 text-xs text-white/40">{tw.disclaimer}</p>
  </div>
</section>
